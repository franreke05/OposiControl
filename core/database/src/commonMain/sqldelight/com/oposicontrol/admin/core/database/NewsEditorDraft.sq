CREATE TABLE news_editor_draft (
    id INTEGER NOT NULL PRIMARY KEY,
    news_id TEXT NOT NULL,
    title TEXT NOT NULL,
    text_content TEXT NOT NULL,
    specialty TEXT NOT NULL,
    type TEXT NOT NULL,
    background_type TEXT NOT NULL,
    background_path TEXT NOT NULL,
    image_path TEXT NOT NULL,
    status TEXT NOT NULL,
    layers_json TEXT NOT NULL,
    canvas_width INTEGER NOT NULL,
    canvas_height INTEGER NOT NULL
);

selectDraft:
SELECT *
FROM news_editor_draft
WHERE id = 1;

upsertDraft:
INSERT OR REPLACE INTO news_editor_draft(
    id,
    news_id,
    title,
    text_content,
    specialty,
    type,
    background_type,
    background_path,
    image_path,
    status,
    layers_json,
    canvas_width,
    canvas_height
) VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

clearDraft:
DELETE FROM news_editor_draft WHERE id = 1;
