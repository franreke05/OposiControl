# STAGING sites for the host Caddy (system service) of oposibots-prod-01. GENERATED by ops/caddy/staging/gen-staging-hostcaddy.mjs
# from ops/caddy/Caddyfile.hostcaddy: same routing as production (control matchers, bot pool, health on /health/live, deny by
# default, /metrics and dev paths 404). Installed as /etc/caddy/staging/staging.caddy and pulled in by ONE line at the end of
# the production Caddyfile: `import /etc/caddy/staging/staging.caddy`. Rollback = remove that line, validate, reload.
# Upstreams: the loopback ports of ops/deploy/compose.staging.yaml only (never production's 18081-18083). TLS: Cloudflare
# Origin CA certificate for both names (/etc/caddy/staging/origin.{pem,key}, readable by the caddy user). Do not hand-edit.
staging-api.oposibots.es {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Proxy-Authorization delete
				request>headers>X-Api-Key delete
				request>headers>Apikey delete
				resp_headers>Set-Cookie delete
				request>uri query {
					delete token
					delete access_token
					delete refresh_token
					delete code
					delete apikey
					delete password
				}
			}
		}
	}
	tls /etc/caddy/staging/origin.pem /etc/caddy/staging/origin.key
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
		X-Robots-Tag "noindex, nofollow"
	}
	header X-Request-Id {http.request.uuid}
	@bounded {
		not header Content-Type multipart/*
	}
	request_body @bounded {
		max_size 2MB
	}
	route {
		@metrics path /metrics /metrics/*
		respond @metrics 404
		@devonly path /admin/backend /admin/backend/* /admin/dev /admin/dev/*
		respond @devonly 404
		@control path /api/v1/admin /api/v1/admin/* /admin/audit /admin/audit/* /admin/exam-access /admin/exam-access/* /admin/moderation /admin/moderation/* /admin/news-types /admin/news-types/* /admin/roles /admin/roles/* /admin/settings /admin/settings/* /admin/support /admin/support/* /admin/ticket-wallets /admin/ticket-wallets/* /admin/users /admin/users/* /content/comunidades /content/comunidades/* /content/especialidades /content/especialidades/* /content/etiquetas /content/etiquetas/* /content/noticias /content/noticias/* /content/preguntas /content/preguntas/* /content/rafaga /content/rafaga/* /content/solucionarios /content/solucionarios/* /dashboard/metrics /tags /search /search/reindex
		handle @control {
			reverse_proxy 127.0.0.1:18183 {
				header_up X-Forwarded-For {remote_host}
				header_up X-Request-Id {http.request.uuid}
				health_uri /health/live
				health_interval 15s
				health_timeout 6s
				health_status 2xx
				transport http {
					dial_timeout 3s
					response_header_timeout 150s
					keepalive 60s
				}
			}
		}
		@bot path /v1/auth/* /v1/especialidades /v1/examenes /v1/examenes/* /api/v1/app /api/v1/app/* /api/v1/webhooks/payments/* /api/v1/webhooks/store/*
		handle @bot {
			reverse_proxy 127.0.0.1:18181 {
				lb_policy least_conn
				lb_retries 2
				lb_try_duration 3s
				lb_try_interval 250ms
				header_up X-Forwarded-For {remote_host}
				header_up X-Request-Id {http.request.uuid}
				health_uri /health/live
				health_interval 10s
				health_timeout 6s
				health_status 2xx
				fail_duration 10s
				max_fails 2
				transport http {
					dial_timeout 3s
					response_header_timeout 25s
					keepalive 60s
				}
			}
		}
		@health path /health /health/live /health/ready
		handle @health {
			reverse_proxy 127.0.0.1:18181 {
				lb_policy first
				header_up X-Forwarded-For {remote_host}
				transport http {
					dial_timeout 2s
					response_header_timeout 8s
				}
			}
		}
		handle {
			respond 404
		}
	}
}

