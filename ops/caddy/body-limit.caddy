# Snippet de ingress (MASTER2-SEC-002): tope de cuerpo para las peticiones que NO son multipart. Las subidas multipart
# (portadas 10 MB, recursos 50 MB) se acotan en la ruta de Ktor; el resto de cuerpos (JSON) no supera 2 MB. Ktor aplica
# el mismo tope sobre `Content-Length` (413 PAYLOAD_TOO_LARGE); esto cubre los cuerpos `chunked` que no declaran longitud.
# MASTER5-API-007: `/v1/auth/*` no pasa por el tope de Ktor (su propio tope de 16 KB responde 400 VALIDATION, el estado
# declarado en openapi/auth); por encima de 2 MB el corte que pueda quedar es de este ingress, no un estado del contrato.
#
#   api.oposibots.es {
#       import /etc/caddy/metrics-block.caddy
#       import /etc/caddy/body-limit.caddy
#       reverse_proxy oposicontrol-ktor:8080
#   }
@bounded {
    not header Content-Type multipart/*
    # Imagen del foro (D5-31): hasta 3 MB, acotada por el pool bot de Caddy y por su ruta en Ktor.
    not path_regexp ^/api/v1/app/oposired/imagenes/[A-Za-z0-9_-]+/contenido$
}
request_body @bounded {
    max_size 2MB
}
