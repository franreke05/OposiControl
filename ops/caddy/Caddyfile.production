# Caddyfile de PRODUCCION (borrador versionado, NO desplegado). Topologia:
#   Cloudflare -> Caddy -> { ktor-bot-1, ktor-bot-2 (pool OposiBot) | ktor-control (OposiControl) } -> Supabase
#
# Variables de entorno (las inyecta compose.production.yaml; nada de esto es secreto):
#   API_HOST      host publico del API (historico: api.oposibots.es). Sin valor por defecto a proposito: si falta, Caddy no arranca.
# Certificado de origen: Cloudflare Origin CA montado en /etc/caddy/origin/{origin.pem,origin.key} (modo SSL "Full (strict)").
#
# Las rutas salen de ops/inventory/routes.combined.txt (manifiesto generado del arbol real de Ktor) y de la seccion 3.7 de
# PRODUCTION_ROUTE_MATRIX. Si se anade un prefijo de ruta al backend, falla RouteInventoryTest y hay que reflejarlo AQUI:
# cualquier ruta no listada responde 404 en el borde (deny by default).
{
	# Detras de Cloudflare no hay certificados automaticos de Let's Encrypt: se usa el Origin CA. Se conserva la
	# redireccion http->https de :80 (no emite certificados).
	auto_https disable_redirects
	admin off

	servers {
		# Solo los rangos de Cloudflare (https://www.cloudflare.com/ips/) pueden decir quien es el cliente real.
		# REFRESCAR esta lista si Cloudflare la cambia (runbook: CLOUDFLARE_RUNBOOK.md, seccion "Rangos de IP").
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP

		timeouts {
			read_header 10s
			read_body 130s
			idle 120s
		}
	}
}

{$API_HOST} {
	tls /etc/caddy/origin/origin.pem /etc/caddy/origin/origin.key

	# Log de acceso en JSON a stdout (lo rota Docker). NUNCA cabeceras de credenciales ni cookies; se vacian tambien los
	# parametros de query tipicos de secretos. El cuerpo no se registra nunca.
	log {
		output stdout
		format filter {
			wrap json
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Proxy-Authorization delete
			request>headers>X-Api-Key delete
			request>headers>Apikey delete
			resp_headers>Set-Cookie delete
			request>uri query {
				delete token
				delete access_token
				delete refresh_token
				delete code
				delete apikey
				delete password
			}
		}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	# Id de peticion generado en el borde (no se confia en uno entrante); el cliente lo recibe y lo cita en soporte.
	header X-Request-Id {http.request.uuid}

	# Tope de cuerpo no multipart (2 MB). Snippet existente; define @bounded y request_body.
	import /etc/caddy/body-limit.caddy

	# Orden de evaluacion = orden escrito.
	route {
		# /metrics NUNCA es publico (snippet existente: 404). Prometheus raspa cada contenedor por la red interna.
		import /etc/caddy/metrics-block.caddy

		# Control del proceso solo en desarrollo: jamas publico (y desmontado en los perfiles bot/control).
		@devonly path /admin/backend /admin/backend/* /admin/dev /admin/dev/*
		respond @devonly 404

		# --- OposiControl (1 instancia): 201 rutas ADMIN, enumeradas. NO se enruta `/admin*` en bloque. ---
		@control path /api/v1/admin /api/v1/admin/* /admin/audit /admin/audit/* /admin/exam-access /admin/exam-access/* /admin/moderation /admin/moderation/* /admin/news-types /admin/news-types/* /admin/roles /admin/roles/* /admin/settings /admin/settings/* /admin/support /admin/support/* /admin/ticket-wallets /admin/ticket-wallets/* /admin/users /admin/users/* /content/comunidades /content/comunidades/* /content/especialidades /content/especialidades/* /content/etiquetas /content/etiquetas/* /content/noticias /content/noticias/* /content/preguntas /content/preguntas/* /content/rafaga /content/rafaga/* /content/solucionarios /content/solucionarios/* /dashboard/metrics /tags /search /search/reindex
		handle @control {
			reverse_proxy ktor-control:8080 {
				header_up X-Forwarded-For {client_ip}
				header_up X-Request-Id {http.request.uuid}
				# Salud activa. Una unica instancia: sin alternativa, un 503 de Caddy es el comportamiento correcto.
				health_uri /health/live
				health_interval 15s
				health_timeout 6s
				health_status 2xx
				transport http {
					dial_timeout 3s
					# Las subidas multipart pasan por ffmpeg (hasta 120 s, MediaCompression.VIDEO_TIMEOUT_MS) y la
					# importacion de PDF es sincrona: cabeceras de respuesta hasta 150 s.
					response_header_timeout 150s
					keepalive 60s
				}
			}
		}

		# --- OposiBot (pool de 2 replicas sin estado): auth, consumer y catalogo publico compartido. ---
		# Webhooks de pago y tienda (Google RTDN, App Store Server Notifications V2): SOLO estos dos prefijos llegan al pool bot; Ktor
		# autentica cada uno (HMAC sandbox local, OIDC Pub/Sub, JWS de Apple). El resto sigue en deny-by-default.
		@bot path /v1/auth/* /v1/especialidades /v1/examenes /v1/examenes/* /api/v1/app /api/v1/app/* /api/v1/webhooks/payments/* /api/v1/webhooks/store/*
		handle @bot {
			reverse_proxy ktor-bot-1:8080 ktor-bot-2:8080 {
				lb_policy least_conn
				lb_retries 2
				lb_try_duration 3s
				lb_try_interval 250ms
				# Cuerpo ENTERO en Caddy antes de ir a Ktor (revision OposiControl 2026-10-22): Ktor coge el permiso de admision antes
				# de leer el cuerpo y `read_body` es 130 s; sin buffer, ~32 POST lentos sin autenticar dejarian a todos en SERVER_BUSY.
				# 2MB = el tope de body-limit.caddy (el pool bot no tiene rutas multipart).
				request_buffers 2MB
				header_up X-Forwarded-For {client_ip}
				header_up X-Request-Id {http.request.uuid}
				# Salud ACTIVA: es la UNICA que saca una replica de rotacion (proceso vivo y sirviendo; /health/live esta exenta de
				# la admision de Ktor, asi que contesta aunque la replica este llena). Cada 5 s: una replica caida sale en <= 5 s.
				health_uri /health/live
				health_interval 5s
				health_timeout 4s
				health_status 2xx
				# SIN salud PASIVA (CERT-LOAD-1000 2026-10-21): Caddy cuenta como fallo pasivo CUALQUIER error de ida y vuelta,
				# tambien el `response_header_timeout`, y no se puede limitar a fallos de conexion. Con `max_fails 2` una punta que
				# encolaba peticiones hasta los 25 s aparto las DOS replicas a la vez ("no upstreams available" para todos). Ahora
				# Ktor rechaza al instante lo que no cabe (503 SERVER_BUSY + Retry-After) y corta por plazo antes del borde; ese 503
				# es una RESPUESTA, no un error: pasa tal cual al cliente y no se reintenta aqui (sin `lb_retry_match` ni
				# `handle_response`). Tampoco `unhealthy_status` / `unhealthy_latency` (F-07: dependencia compartida -> caida total).
				# Al apagarse (SIGTERM) Ktor DRENA: /health/live responde 503 DRAINING y sigue atendiendo SHUTDOWN_DRAIN_MS (10 s >
				# 5 s + 4 s de la sonda) antes de cerrar el puerto, asi que una parada ordenada no deja 502. Solo una caida brusca
				# (kill, OOM) recibe peticiones hasta la siguiente sonda (<= 5 s);
				# lb_retries reintenta los fallos de CONEXION (siempre reintentables) durante lb_try_duration.
				transport http {
					# 1 s (red interna): deja sitio a los reintentos de conexion dentro de lb_try_duration 3s.
					dial_timeout 1s
					# Ktor corta a Supabase a los 20 s (UPSTREAM_REQUEST_TIMEOUT_MS) y cada peticion bot tiene un plazo de 15 s
					# (BOT_REQUEST_DEADLINE_MS): 25 s deja margen a su 503/504 propio.
					response_header_timeout 25s
					keepalive 60s
				}
			}
		}

		# --- Sondas publicas (liveness/readiness del pool OposiBot; /health legado solo lo consulta el diagnostico). ---
		@health path /health /health/live /health/ready
		handle @health {
			reverse_proxy ktor-bot-1:8080 ktor-bot-2:8080 {
				lb_policy first
				header_up X-Forwarded-For {client_ip}
				transport http {
					dial_timeout 2s
					response_header_timeout 8s
				}
			}
		}

		# Deny by default: ninguna otra ruta llega a Ktor.
		handle {
			respond 404
		}
	}
}
