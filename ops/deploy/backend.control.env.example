# NOMBRES de variables que SOLO lee el perfil `control` (rutas de administracion tras `gateway-auth`). Sin valores.
# Copiar a /etc/oposibots/production/backend.control.env (FUERA del repo, root:root, modo 0600). Lo carga SOLO
# ktor-control; los contenedores bot NO (no montan ninguna ruta admin: `gatewayBearerAuth` y los gateways de
# administracion solo se instalan con `ServerProfile.mountsControl`).
# Derivado del codigo: Application.kt (gatewayBearerAuth), AdminGateway.kt (adminSettingsFromEnvironment), NewsGateway.kt.
#
# NO va aqui: nada del runtime de auth de consumidor (backend.bot.env.example); control no lo construye.

# --- Control (gateway admin) ---
OPOSICONTROL_BACKEND_TOKEN=
ENABLE_VERBOSE_NETWORK_LOGS=
SUPABASE_BUCKET_NEWS_ASSETS=

# Notas de valores (sin valores reales):
#  - OPOSICONTROL_BACKEND_TOKEN: token estatico del gateway admin. Es un secreto de ADMINISTRACION: solo en este fichero.
#  - PROMETHEUS_URL la fija compose en el servicio ktor-control.
