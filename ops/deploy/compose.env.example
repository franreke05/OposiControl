# NOMBRES de variables de INTERPOLACION de compose.production.yaml (--env-file /etc/oposibots/production/compose.env).
# Fuera del repo, modo 0600. Sin valores aqui.
#
# Obligatorias:
#   BACKEND_IMAGE           oposicontrol-backend:<sha12> o repo@sha256:<digest>  (rollback = imagen anterior)
#   API_HOST                host publico del API (historico: api.oposibots.es)
#   VALKEY_PASSWORD
#   GRAFANA_ADMIN_PASSWORD
BACKEND_IMAGE=
API_HOST=
VALKEY_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Opcionales (tienen valor por defecto en el compose):
#   BACKEND_COMMON_ENV_FILE BACKEND_BOT_ENV_FILE BACKEND_CONTROL_ENV_FILE
#   ORIGIN_CERT_DIR METRICS_TOKEN_FILE CADDY_IPV4 EDGE_SUBNET GRAFANA_ADMIN_USER
#   BOT_CPUS BOT_MEM_LIMIT BOT_JAVA_TOOL_OPTIONS CONTROL_CPUS CONTROL_MEM_LIMIT CONTROL_JAVA_TOOL_OPTIONS
#   CADDY_MEM_LIMIT VALKEY_MEM_LIMIT PROMETHEUS_MEM_LIMIT GRAFANA_MEM_LIMIT
#   CADDY_IMAGE VALKEY_IMAGE PROMETHEUS_IMAGE GRAFANA_IMAGE
# Alertas por correo (Alertmanager): rutas FUERA del repo; plantilla en ops/monitoring/alertmanager/alertmanager.yml.example.
#   ALERTMANAGER_CONFIG_FILE ALERTMANAGER_SMTP_PASSWORD_FILE ALERTMANAGER_IMAGE ALERTMANAGER_MEM_LIMIT
