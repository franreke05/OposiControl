# NOMBRES de variables del backend Ktor en produccion que leen LOS DOS perfiles (bot y control). Sin valores.
# Copiar a /etc/oposibots/production/backend.common.env (FUERA del repo, root:root, modo 0600) y rellenar alli. Nunca
# commitear valores. Lo cargan los tres contenedores Ktor (compose.production.yaml: x-env-bot y x-env-control).
# Lista derivada del codigo (backend/ktor/src/main/kotlin: System.getenv / environment(...)), no de ningun .env:
# Application.kt, AppEnvironment.kt, Observability.kt, PrometheusMetrics.kt, SupabaseRequestTransport.kt,
# SupabaseRequestAuthPolicy.kt, CatalogGateway.kt.
#
# NO van aqui: lo que solo lee el runtime de auth de consumidor (backend.bot.env.example) ni lo que solo leen las rutas de
# administracion (backend.control.env.example). Las fija compose por servicio: SERVER_PROFILE, JAVA_TOOL_OPTIONS,
# PROMETHEUS_URL (control).

# --- Entorno ---
APP_ENV=
LOG_LEVEL=
SLOW_REQUEST_THRESHOLD_MS=
HOST=
PORT=
SHUTDOWN_GRACE_PERIOD_MS=
SHUTDOWN_TIMEOUT_MS=
SHUTDOWN_DRAIN_MS=

# --- Supabase (obligatorias; clave de servicio: nunca vuelve al cliente) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_EXAM_RESOURCES=
UPSTREAM_CONNECT_TIMEOUT_MS=
UPSTREAM_REQUEST_TIMEOUT_MS=

# --- Metricas ---
METRICS_ENABLED=
METRICS_SCRAPE_TOKEN=

# --- Sentry (nube; DSN vacio = desactivado) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=

# Notas de valores (sin valores reales):
#  - APP_ENV: production | staging.
#  - SUPABASE_SECRET_KEY o, si no existe, SUPABASE_SERVICE_ROLE_KEY (una de las dos).
#  - METRICS_SCRAPE_TOKEN: mismo valor que el fichero metrics_token que monta Prometheus.
#  - SENTRY_RELEASE: fijar al tag/sha de la imagen.
#  - SHUTDOWN_DRAIN_MS: drenaje al recibir SIGTERM (vacio = 10000 en perfil bot, 0 en el resto): /health/live pasa a 503 DRAINING
#    al instante y la replica sigue atendiendo ese tiempo (> sonda de Caddy 5 s + 4 s) antes de parar. Con drenaje, SHUTDOWN_TIMEOUT_MS
#    vacio = 20000 (10 + 20 = 30 s < stop_grace_period 35 s); sin drenaje, 25000. SHUTDOWN_GRACE_PERIOD_MS vacio = 5000.
#
# SOLO DESARROLLO, NO definir en produccion (en ninguno de los tres ficheros):
#   OPOSICONTROL_ALLOW_DEV_TOKEN, OPOSICONTROL_ALLOW_DEV_USER, OPOSICONTROL_ENABLE_BACKEND_RESTART,
#   OPOSICONTROL_ADMIN_EMAIL, OPOSICONTROL_ADMIN_DISPLAY_NAME
#   PAYMENTS_SANDBOX_SECRET: proveedor de pago sandbox, SOLO local/test (ops/local-exam). main() lo comprueba en TODOS los
#   perfiles antes de enlazar el puerto: con valor y APP_ENV distinto de EXACTAMENTE `local` o `test`, el proceso termina con
#   codigo 78 (PaymentProviders.kt, enforceSandboxProviderGuard).
