# NOMBRES de variables del backend Ktor en produccion (sin valores). Copiar a /etc/oposibots/production/backend.env
# (FUERA del repo, root:root, modo 0600) y rellenar alli. Nunca commitear valores. Lista derivada del codigo
# (backend/ktor/src/main/kotlin: System.getenv / environment(...)), no de ningun .env.
#
# Las fija compose por servicio y NO van aqui:  SERVER_PROFILE, JAVA_TOOL_OPTIONS, PROMETHEUS_URL (control).

# --- Entorno ---
APP_ENV=
LOG_LEVEL=
SLOW_REQUEST_THRESHOLD_MS=
HOST=
PORT=

# --- Supabase (obligatorias; nunca vuelven al cliente) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET_EXAM_RESOURCES=
SUPABASE_BUCKET_NEWS_ASSETS=
UPSTREAM_CONNECT_TIMEOUT_MS=
UPSTREAM_REQUEST_TIMEOUT_MS=

# --- Auth OposiBot (runtime obligatorio en bot; el arranque falla cerrado si falta) ---
OPOSIBOTS_AUTH_ENABLED=
AUTH_RATE_LIMIT_MODE=
AUTH_RATE_LIMIT_HMAC_SECRET=
VALKEY_URL=
AUTH_CAPTCHA_REQUIRED=
TRUST_PROXY_HEADERS=
TRUSTED_PROXY_HOSTS=
SUPABASE_AUTH_FORWARD_CLIENT_IP=
OPOSIBOTS_PASSWORD_RECOVERY_REDIRECT_URL=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Control (gateway admin) ---
OPOSICONTROL_BACKEND_TOKEN=
ENABLE_VERBOSE_NETWORK_LOGS=

# --- Metricas ---
METRICS_ENABLED=
METRICS_SCRAPE_TOKEN=

# --- Sentry (nube; DSN vacio = desactivado) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=

# Notas de valores (sin valores reales):
#  - APP_ENV: production | staging.  AUTH_RATE_LIMIT_MODE: `valkey` (memory solo en desarrollo).
#  - AUTH_RATE_LIMIT_HMAC_SECRET: >= 32 caracteres.  TRUST_PROXY_HEADERS: true (obligatorio fuera de desarrollo).
#  - TRUSTED_PROXY_HOSTS: IP LITERAL de caddy en la red edge (CADDY_IPV4 de compose.env, p. ej. la 10 de la subred).
#  - VALKEY_URL: esquema redis con la contrasena de VALKEY_PASSWORD (compose.env) y host `valkey`.
#  - METRICS_SCRAPE_TOKEN: mismo valor que el fichero metrics_token que monta Prometheus.
#  - SENTRY_RELEASE: fijar al tag/sha de la imagen.
#
# SOLO DESARROLLO, NO definir en produccion:
#   OPOSICONTROL_ALLOW_DEV_TOKEN, OPOSICONTROL_ALLOW_DEV_USER, OPOSICONTROL_ENABLE_BACKEND_RESTART,
#   OPOSICONTROL_ADMIN_EMAIL, OPOSICONTROL_ADMIN_DISPLAY_NAME
