# NOMBRES de variables que SOLO lee el perfil `bot` (runtime de auth de consumidor). Sin valores.
# Copiar a /etc/oposibots/production/backend.bot.env (FUERA del repo, root:root, modo 0600). Lo cargan ktor-bot-1 y
# ktor-bot-2 (el MISMO fichero: el secreto HMAC del limitador tiene que ser identico en las dos replicas); ktor-control NO.
# Derivado del codigo: las de auth se leen en OposiBotsAuthConfiguration.kt, que `Application.module` NO construye con
# SERVER_PROFILE=control (`authRuntime = null`); las de economia en EconomyRoutes.kt/EconomyService.kt (rutas de consumidor,
# solo `mountsBot`) y CHALLENGE_JOB_SECONDS en DailyChallengeJob.kt (Application.kt lo arranca solo si el perfil no es control).
#
# NO va aqui (y un bot no debe tenerlo): OPOSICONTROL_BACKEND_TOKEN ni nada de backend.control.env.example.

# --- Auth OposiBot (obligatorio en bot; el arranque falla cerrado si falta) ---
OPOSIBOTS_AUTH_ENABLED=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
AUTH_RATE_LIMIT_MODE=
AUTH_RATE_LIMIT_HMAC_SECRET=
VALKEY_URL=
AUTH_CAPTCHA_REQUIRED=
TRUST_PROXY_HEADERS=
TRUSTED_PROXY_HOSTS=
SUPABASE_AUTH_FORWARD_CLIENT_IP=
OPOSIBOTS_PASSWORD_RECOVERY_REDIRECT_URL=
OPOSIBOTS_EMAIL_CONFIRM_REDIRECT_URL=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
AUTH_PKCE_MODE=

# --- Economia V1 y trabajo periodico (bot; control no los lee) ---
PAYMENTS_REFUNDS_ENABLED=
CHALLENGE_JOB_SECONDS=

# Notas de valores (sin valores reales):
#  - OPOSIBOTS_AUTH_ENABLED: el perfil bot monta el runtime de auth SIEMPRE (lo exige); la variable solo decide en combined.
#  - SUPABASE_PUBLISHABLE_KEY o, si no existe, SUPABASE_ANON_KEY (una de las dos).
#  - AUTH_RATE_LIMIT_MODE: OBLIGATORIA, sin ella el perfil bot no arranca: `valkey` (memory solo en desarrollo).  AUTH_RATE_LIMIT_HMAC_SECRET: >= 32 caracteres.
#  - TRUST_PROXY_HEADERS: true (obligatorio fuera de desarrollo).
#  - TRUSTED_PROXY_HOSTS: IP LITERAL de caddy en la red edge (CADDY_IPV4 de compose.env, p. ej. la 10 de la subred).
#  - VALKEY_URL: esquema redis con la contrasena de VALKEY_PASSWORD (compose.env) y host `valkey`.
#  - OPOSIBOTS_EMAIL_CONFIRM_REDIRECT_URL (opcional): `redirect_to` del correo de confirmacion (alta y reenvio), como
#    OPOSIBOTS_PASSWORD_RECOVERY_REDIRECT_URL lo es del de recuperacion. Vacia = no se envia. Tiene que estar en la lista de
#    redirecciones permitidas del proyecto de Supabase Auth.
#  - AUTH_PKCE_MODE (FA39, EmailCodeBinding.kt): off | optional | required; vacia = optional; otro valor aborta el arranque.
#    Hoy `optional`. Debe pasar a `required` cuando App Links y los clientes de tienda envien codeChallenge/codeVerifier.
#  - PAYMENTS_REFUNDS_ENABLED: `false` hasta que el propietario decida la politica de reembolso. true/false explicito manda;
#    vacia = encendida SOLO con APP_ENV exactamente local o test (en produccion queda apagada).
#  - CHALLENGE_JOB_SECONDS: intervalo en segundos del reto diario y trabajos idempotentes; vacia = 900 (valor de produccion).
#    0 o negativo = apagado; un valor no numerico cae a 900. Corre en las dos replicas bajo cerrojo consultivo de la base.
#  - PAYMENTS_SANDBOX_SECRET NO va aqui ni en produccion: ver SOLO DESARROLLO en backend.common.env.example.
