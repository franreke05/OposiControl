# STAGING: NAMES read only by the bot profile. Real file: /etc/oposibots/staging/backend.bot.env (root:root, 0600).
#
# FIXED by compose.staging.yaml (do not set): AUTH_PKCE_MODE=required, AUTH_RATE_LIMIT_MODE=valkey, TRUST_PROXY_HEADERS=true,
# PAYMENTS_STORE_GOOGLE_PLAY_ENABLED=false, PAYMENTS_STORE_APP_STORE_ENABLED=false, PAYMENTS_STORE_LIVE_CREDIT_ENABLED=false (G1),
# PAYMENTS_STORE_SUBSCRIPTIONS_ENABLED=false (D8), PAYMENTS_STORE_SANDBOX=reject, PAYMENTS_STORE_JOB_SECONDS=0,
# PAYMENTS_REFUNDS_ENABLED=false. Store sandbox purchases need a separate owner GO and a compose change, not an env edit.
OPOSIBOTS_AUTH_ENABLED=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
AUTH_RATE_LIMIT_HMAC_SECRET=
VALKEY_URL=
AUTH_CAPTCHA_REQUIRED=
TRUSTED_PROXY_HOSTS=
SUPABASE_AUTH_FORWARD_CLIENT_IP=
OPOSIBOTS_PASSWORD_RECOVERY_REDIRECT_URL=
OPOSIBOTS_EMAIL_CONFIRM_REDIRECT_URL=
AUTH_OAUTH_NONCE_REQUIRED=
CHALLENGE_JOB_SECONDS=
# Notes (no values):
#  - SUPABASE_PUBLISHABLE_KEY (or SUPABASE_ANON_KEY): the STAGING project's.
#  - AUTH_RATE_LIMIT_HMAC_SECRET: new random >= 32 chars, never production's.
#  - VALKEY_URL: redis scheme, host `valkey`, password = STAGING_VALKEY_PASSWORD.
#  - TRUSTED_PROXY_HOSTS: the staging network gateway (STAGING_GATEWAY, default 172.30.28.1): the host Caddy arrives through it.
#  - Redirect URLs: staging-only (https://staging-api.oposibots.es/... or the app's staging scheme) and present in the STAGING
#    project's Auth redirect allow-list. Apple sign-in is not configured in staging (APPLE_* absent).
