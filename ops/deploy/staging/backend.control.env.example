# STAGING: NAMES read only by the control profile. Real file: /etc/oposibots/staging/backend.control.env (root:root, 0600).
#
# FIXED by compose.staging.yaml (do not set): ADMIN_RATE_LIMIT_MODE=valkey, PROMETHEUS_URL.
OPOSICONTROL_BACKEND_TOKEN=
ENABLE_VERBOSE_NETWORK_LOGS=
SUPABASE_BUCKET_NEWS_ASSETS=
ADMIN_RATE_LIMIT_HMAC_SECRET=
ADMIN_RATE_LIMIT_VALKEY_URL=
ADMIN_MUTATION_RATE_LIMIT_PER_MINUTE=
# Notes (no values):
#  - OPOSICONTROL_BACKEND_TOKEN and ADMIN_RATE_LIMIT_HMAC_SECRET: new random values (>= 32), distinct from the bot HMAC and from production.
#  - ADMIN_RATE_LIMIT_VALKEY_URL: redis scheme, host `valkey`, password = STAGING_VALKEY_PASSWORD.
#  - ENABLE_VERBOSE_NETWORK_LOGS: false.
