# STAGING: NAMES of the interpolation variables of ops/deploy/compose.staging.yaml. Real file: /etc/oposibots/staging/compose.env
# (root:root, 0600). No values here, ever. Nothing here may be copied from /etc/oposibots/production.
#
# Required:
#   BACKEND_IMAGE             oposicontrol-backend:<sha12> built LOCALLY from the validated commit and transferred (never built on the host)
#   STAGING_VALKEY_PASSWORD   new random value (>= 32 chars); the same one goes inside VALKEY_URL / ADMIN_RATE_LIMIT_VALKEY_URL
BACKEND_IMAGE=
STAGING_VALKEY_PASSWORD=
# Optional (defaults in the compose file; change only with a documented reason):
#   STAGING_COMMON_ENV_FILE STAGING_BOT_ENV_FILE STAGING_CONTROL_ENV_FILE STAGING_METRICS_TOKEN_FILE
#   STAGING_SUBNET (172.30.28.0/24) STAGING_GATEWAY (172.30.28.1) STAGING_BOT_PORT (18181) STAGING_CONTROL_PORT (18183)
#   STAGING_BOT_CPUS STAGING_BOT_MEM_LIMIT STAGING_BOT_JAVA_TOOL_OPTIONS STAGING_CONTROL_CPUS STAGING_CONTROL_MEM_LIMIT
#   STAGING_CONTROL_JAVA_TOOL_OPTIONS VALKEY_IMAGE PROMETHEUS_IMAGE
