# Plantilla de la configuracion de Alertmanager. El fichero REAL vive fuera del repo (ALERTMANAGER_CONFIG_FILE en compose.env):
# sustituir ALERT_EMAIL por la direccion que envia y recibe. La contrasena (contrasena de aplicacion de la cuenta, nunca la
# de la cuenta) va en el fichero ALERTMANAGER_SMTP_PASSWORD_FILE, modo 0400. Puerto 587: el proveedor bloquea 25 y 465.
global:
  smtp_smarthost: smtp.gmail.com:587
  smtp_from: ALERT_EMAIL
  smtp_auth_username: ALERT_EMAIL
  smtp_auth_password_file: /etc/alertmanager/secrets/smtp_password
  smtp_require_tls: true

route:
  receiver: owner-email
  group_by: [alertname]
  group_wait: 30s
  group_interval: 10m
  repeat_interval: 6h

receivers:
  - name: owner-email
    email_configs:
      - to: ALERT_EMAIL
        send_resolved: true
        headers:
          Subject: '[OposiBots] {{ .Status | toUpper }}: {{ .CommonLabels.alertname }}'
