            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (rate(ktor_http_server_requests_seconds_count{route!=\"/metrics\"}[5m]))",
          "legendFormat": "{{replica}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
