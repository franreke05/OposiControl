SUPABASE_URL=https://ndiooyyqtaeysnedywer.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SUPABASE_SECRET_KEY
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_SUPABASE_PUBLISHABLE_KEY
OPOSICONTROL_BACKEND_TOKEN=REPLACE_WITH_RANDOM_BACKEND_TOKEN
APP_ENV=dev

# Auth consumer OposiBots. En producción usa SERVER_PROFILE=consumer,
# AUTH_RATE_LIMIT_MODE=valkey y un secreto HMAC aleatorio de 32+ caracteres.
OPOSIBOTS_AUTH_ENABLED=true
SERVER_PROFILE=combined
AUTH_RATE_LIMIT_MODE=memory
AUTH_RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
VALKEY_URL=redis://127.0.0.1:6379
AUTH_CAPTCHA_REQUIRED=false
TRUST_PROXY_HEADERS=false
# Lista exacta separada por comas; obligatoria al activar TRUST_PROXY_HEADERS.
TRUSTED_PROXY_HOSTS=127.0.0.1
SUPABASE_AUTH_FORWARD_CLIENT_IP=false
OPOSIBOTS_PASSWORD_RECOVERY_REDIRECT_URL=oposibots://auth/reset-password

# URL del backend para el flavor dev.
# Emulador Android: http://10.0.2.2:8080
# Dispositivo físico / ngrok: https://xxxx.ngrok-free.app
BASE_URL=http://10.0.2.2:8080

# Token Bearer de /metrics (Prometheus lo envia con credentials_file). Vacio = /metrics abierto: SOLO desarrollo.
METRICS_SCRAPE_TOKEN=
