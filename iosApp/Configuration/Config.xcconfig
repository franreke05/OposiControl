TEAM_ID=

PRODUCT_NAME=OposiControl
PRODUCT_BUNDLE_IDENTIFIER=com.example.oposicontrol.OposiControl$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

OTHER_LDFLAGS=$(inherited) -lsqlite3

APP_ENV=dev
LOCAL_BACKEND_HOST=192.168.1.52
BASE_URL=http:/$()/$(LOCAL_BACKEND_HOST):8080
SUPABASE_BUCKET_EXAM_RESOURCES=exam-resources
ENABLE_LOGS=true
ENABLE_ANALYTICS=false
ENABLE_VERBOSE_NETWORK_LOGS=true
